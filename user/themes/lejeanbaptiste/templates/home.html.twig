{% extends 'default.html.twig' %}

{% block main %}
  {% set is_en = grav.language.getLanguage == 'en' %}
  <main class="hero">
    <div class="hero__texture" aria-hidden="true"></div>
    <img class="hero__splash" src="{{ url('theme://images/long_splash.png') }}" alt="">
    <section class="hero__copy">
      <div class="hero__rule"><span></span><i>✦</i><span></span></div>
      <div class="hero__content">{{ page.content|raw }}</div>
    </section>
  </main>

  <section class="home-capabilities">
    <div class="home-section-heading">
      <p class="eyebrow">{{ is_en ? 'What Grognard does' : 'Ce que Grognard fait' }}</p>
      <h2>{{ is_en ? 'Four tools,' : 'Quatre outils,' }}<br>{{ is_en ? 'one shared folder.' : 'un même dossier.' }}</h2>
    </div>
    <div class="capability-grid">
      <article><span>01</span><h3>{{ is_en ? 'Encode' : 'Encoder' }}</h3><p>{{ is_en ? 'Visual editing and real XML: TEI is not an export. People, places, works, dates, offices—all in the file you save.' : 'Vue visuelle et XML réel : le TEI n’est pas un export. Personnes, lieux, œuvres, dates, offices — dans le fichier que vous enregistrez.' }}</p></article>
      <article><span>02</span><h3>{{ is_en ? 'Identify' : 'Identifier' }}</h3><p>{{ is_en ? 'Automatic markup, disambiguation, and authority packs stored on disk (CBDB, DILA, CHGIS, Wikidata, NDL…).' : 'Balisage automatique, désambiguïsation, packs d’autorités sur le disque (CBDB, DILA, CHGIS, Wikidata, NDL…).' }}</p></article>
      <article><span>03</span><h3>{{ is_en ? 'Build knowledge' : 'Capitaliser' }}</h3><p>{% if is_en %}Every decision enters <em>your</em> database: records, dates, official titles. Reusable in editing, translation, and Word.{% else %}Chaque décision entre dans <em>votre</em> base : fiches, dates, titres officiels. Réutilisable dans l’édition, la traduction, et Word.{% endif %}</p></article>
      <article><span>04</span><h3>{{ is_en ? 'Translate' : 'Traduire' }}</h3><p>{{ is_en ? 'Companion files aligned with the source. AI does not rewrite your entities; Zotero stays in the translation pane.' : 'Fichiers compagnons alignés sur la source. L’IA ne réécrit pas vos entités ; Zotero reste dans le volet de traduction.' }}</p></article>
    </div>
  </section>

  <section class="home-screenshots" aria-label="{{ is_en ? 'Interface previews' : 'Aperçus de l’interface' }}">
    <div class="home-section-heading home-section-heading--light">
      <p class="eyebrow">{{ is_en ? 'The workshop' : 'L’atelier' }}</p>
      <h2>{% if is_en %}What you see<br>while working.{% else %}Ce que l’on voit<br>en travaillant.{% endif %}</h2>
      <p>{{ is_en ? 'The text, the authority decision, the record—three views of the same project.' : 'Le texte, la décision d’autorité, la fiche — trois vues du même projet.' }}</p>
    </div>
    <div class="screenshot-grid">
      <figure class="product-shot">
        <a class="product-shot__frame" href="/images/screenshot_tagging_manual.png">
          <img src="/images/screenshot_tagging_manual.png" alt="Balisage d’un passage dans la vue visuelle : le texte chinois, l’explorateur, le choix de la balise">
        </a>
        <figcaption><strong>{{ is_en ? 'Encode' : 'Encoder' }}</strong><span>{{ is_en ? 'The text and TEI in the same window.' : 'Le texte et le TEI dans la même fenêtre.' }}</span></figcaption>
      </figure>
      <figure class="product-shot">
        <a class="product-shot__frame" href="/images/screenshot_disambiguation.png">
          <img src="/images/screenshot_disambiguation.png" alt="Panneau de désambiguïsation avec des candidats d’autorité">
        </a>
        <figcaption><strong>{{ is_en ? 'Identify' : 'Identifier' }}</strong><span>{{ is_en ? 'Authority candidates, decision preserved.' : 'Candidats d’autorité, décision conservée.' }}</span></figcaption>
      </figure>
      <figure class="product-shot">
        <a class="product-shot__frame" href="/images/screenshot_db_viewer.png">
          <img src="/images/screenshot_db_viewer.png" alt="Fenêtre de la base d’entités à côté du corpus">
        </a>
        <figcaption><strong>{{ is_en ? 'Build knowledge' : 'Capitaliser' }}</strong><span>{{ is_en ? 'The record, not just the tag.' : 'La fiche, pas seulement la balise.' }}</span></figcaption>
      </figure>
    </div>
  </section>

  <section class="home-workflow">
    <div class="home-section-heading">
      <p class="eyebrow">{{ is_en ? 'The workflow' : 'Le parcours' }}</p>
      <h2>{% if is_en %}A project,<br>not a file.{% else %}Un projet,<br>pas un fichier.{% endif %}</h2>
    </div>
    <div class="workflow-copy">
      <p>{{ is_en ? 'You open a folder: schema, texts, translations, and entity database. The four tools above work together within that single unit.' : 'Vous ouvrez un dossier : schéma, textes, traductions, base d’entités. Les quatre outils ci-dessus s’enchaînent dans cette unité.' }}</p>
      <div class="workflow-grid">
        <article><span>01</span><h3>{{ is_en ? 'Open' : 'Ouvrir' }}</h3><p>{{ is_en ? 'Create or open the project.' : 'Créer ou ouvrir le projet.' }}</p></article>
        <article><span>02</span><h3>{{ is_en ? 'Transcribe' : 'Transcrire' }}</h3><p>{{ is_en ? 'Import or write the source.' : 'Importer ou écrire la source.' }}</p></article>
        <article><span>03</span><h3>{{ is_en ? 'Encode' : 'Encoder' }}</h3><p>{{ is_en ? 'Mark up according to the schema.' : 'Baliser selon le schéma.' }}</p></article>
        <article><span>04</span><h3>{{ is_en ? 'Identify' : 'Identifier' }}</h3><p>{{ is_en ? 'Decide in the database.' : 'Décider dans la base.' }}</p></article>
        <article><span>05</span><h3>{{ is_en ? 'Translate' : 'Traduire' }}</h3><p>{{ is_en ? 'Aligned companion, or article.' : 'Compagnon aligné, ou article.' }}</p></article>
        <article><span>06</span><h3>{{ is_en ? 'Validate' : 'Valider' }}</h3><p>{{ is_en ? 'Schema, save, and copies.' : 'Schéma, enregistrement, copies.' }}</p></article>
      </div>
      <a class="text-link" href="/guide/fonctions-de-base">{{ is_en ? 'The guide’s first hour' : 'La première heure du guide' }} <span aria-hidden="true">→</span></a>
    </div>
    <figure class="product-shot product-shot--wide">
      <a class="product-shot__frame" href="/images/screenshot_translation.png">
        <img src="/images/screenshot_translation.png" alt="Source et traduction alignées dans le même projet">
      </a>
      <figcaption><strong>{{ is_en ? 'Translate' : 'Traduire' }}</strong><span>{{ is_en ? 'A companion aligned with the source, in the same folder.' : 'Compagnon aligné sur la source, dans le même dossier.' }}</span></figcaption>
    </figure>
  </section>

  <section class="home-corpora">
    <div class="home-section-heading home-section-heading--light">
      <p class="eyebrow">{{ is_en ? 'Paths for your sources' : 'Des chemins selon vos sources' }}</p>
      <h2>{% if is_en %}Which<br><em>corpora?</em>{% else %}Pour quels<br><em>corpus&nbsp;?</em>{% endif %}</h2>
    </div>
    <div class="corpus-grid">
      <article>
        <h3>{{ is_en ? 'China and the Buddhist canon' : 'Chine et canon bouddhique' }}</h3>
        <p>{{ is_en ? 'CBDB, DILA, CHGIS, Norbert, Kanripo, CBETA, Daozang—packs and imports on disk.' : 'CBDB, DILA, CHGIS, Norbert, Kanripo, CBETA, Daozang — packs et imports sur le disque.' }}</p>
        <a class="text-link" href="/ressources">{{ is_en ? 'Licenses and packs' : 'Licences et packs' }} <span aria-hidden="true">→</span></a>
      </article>
      <article>
        <h3>{{ is_en ? 'Japan and East Asia' : 'Japon et est-asiatique' }}</h3>
        <p>{{ is_en ? 'NDL, Wikidata, and Sanmiao for dates; the same local-project approach.' : 'NDL, Wikidata, Sanmiao pour les dates ; même logique de projet local.' }}</p>
        <a class="text-link" href="/guide/fichiers">{{ is_en ? 'Imports and files' : 'Imports et fichiers' }} <span aria-hidden="true">→</span></a>
      </article>
      <article>
        <h3>{{ is_en ? 'Other TEI' : 'Autre TEI' }}</h3>
        <p>{{ is_en ? 'Schema, validation, companion translation. No Chinese authorities by magic: just a desktop XML editor.' : 'Schéma, validation, traduction compagnon. Pas les autorités chinoises par magie : un éditeur XML de bureau.' }}</p>
        <a class="text-link" href="/comparaison">{{ is_en ? 'Where Grognard stops' : 'Où Grognard s’arrête' }} <span aria-hidden="true">→</span></a>
      </article>
    </div>
  </section>

  <section class="home-comparison">
    <div class="home-section-heading home-section-heading--light">
      <p class="eyebrow">{{ is_en ? 'Among other tools' : 'Parmi d’autres outils' }}</p>
      <h2>{{ is_en ? 'Why Grognard?' : 'Pourquoi Grognard&nbsp;?' }}</h2>
    </div>
    <div class="comparison-copy">
      <p>{% if is_en %}oXygen edits XML. Web platforms tag online. Grognard tags with scholarly authorities <em>on your disk</em> and records the decisions in your own database.{% else %}oXygen édite le XML. Les plateformes web taguent en ligne. Grognard tague avec des autorités savantes <em>sur votre disque</em>, et verse les décisions dans une base à vous.{% endif %}</p>
    </div>
    <div class="comparison-table" role="table" aria-label="Trois paradigmes">
      <div role="row" class="comparison-table__head"><span role="columnheader">{{ is_en ? 'Tool' : 'Outil' }}</span><span role="columnheader">{{ is_en ? 'Does well' : 'Fait bien' }}</span><span role="columnheader">{{ is_en ? 'Leaves aside' : 'Laisse de côté' }}</span></div>
      <div role="row"><strong role="cell">oXygen</strong><span role="cell">XML, XSLT, validation</span><span role="cell">Autorités est-asiatiques, base d’entités</span></div>
      <div role="row"><strong role="cell">{{ is_en ? 'Web platforms' : 'Plateformes web' }}</strong><span role="cell">{{ is_en ? 'Tagging, online corpora' : 'Taggage, corpus en ligne' }}</span><span role="cell">{{ is_en ? 'Local files, adjacent scripts, sovereignty' : 'Fichiers locaux, scripts à côté, souveraineté' }}</span></div>
      <div role="row"><strong role="cell">Grognard</strong><span role="cell">{{ is_en ? 'Local TEI, packs, database, translation' : 'TEI local, packs, base, traduction' }}</span><span role="cell">{{ is_en ? 'HTR, public site, XSLT pipeline' : 'HTR, site public, chaîne XSLT' }}</span></div>
    </div>
    <a class="text-link comparison-more" href="/comparaison">{{ is_en ? 'The full argument' : 'L’argument développé' }} <span aria-hidden="true">↗</span></a>
  </section>

  <section class="home-facts">
    <div class="home-section-heading">
      <p class="eyebrow">{{ is_en ? 'Good to know' : 'À savoir' }}</p>
      <h2>{% if is_en %}Desktop, open-source,<br>still in beta.{% else %}Bureau, libre,<br>encore en bêta.{% endif %}</h2>
    </div>
    <div class="facts-grid">
      <article><strong>{{ is_en ? 'Desktop application' : 'Application de bureau' }}</strong><p>{{ is_en ? 'macOS, Windows, Linux. No account required for editing.' : 'macOS, Windows, Linux. Pas de compte pour éditer.' }} <a href="/download#configuration">{{ is_en ? 'Size and requirements' : 'Taille et configuration' }}</a>.</p></article>
      <article><strong>AGPL-3</strong><p>{{ is_en ? 'The code is open-source. Your texts stay in the project.' : 'Le code est libre. Vos textes restent dans le projet.' }} <a href="/projet">{{ is_en ? 'Code credits and licenses' : 'Crédits et licences de code' }}</a>.</p></article>
      <article><strong>{{ is_en ? 'Optional' : 'À la carte' }}</strong><p>{{ is_en ? 'AI, leaderboard, LanguageTool, and authority packs: only if you accept them.' : 'IA, classement, LanguageTool, packs d’autorités : seulement si vous les acceptez.' }}</p></article>
    </div>
  </section>

  <section class="home-coda">
    <p class="eyebrow">{{ is_en ? 'Install' : 'Installer' }}</p>
    <h2>{{ is_en ? 'On your machine.' : 'Sur votre machine.' }}</h2>
    <p>{{ is_en ? 'Signed installers for Mac, Windows, and Linux.' : 'Installeurs signés pour Mac, Windows et Linux.' }}</p>
    <div class="home-actions">
      <a class="button button--gold" href="/download">{{ is_en ? 'Download Grognard' : 'Télécharger Grognard' }} <span aria-hidden="true">→</span></a>
    </div>
  </section>
{% endblock %}
