{% extends 'default.html.twig' %}

{% block main %}
  <main class="hero">
    <div class="hero__texture" aria-hidden="true"></div>
    <img class="hero__splash" src="{{ url('theme://images/long_splash.png') }}" alt="">
    <section class="hero__copy">
      <div class="hero__rule"><span></span><i>✦</i><span></span></div>
      <div class="hero__content">{{ page.content|raw }}</div>
    </section>
  </main>

  <section class="home-capabilities">
    <div class="home-section-heading">
      <p class="eyebrow">Ce que Grognard fait</p>
      <h2>Quatre outils,<br>un même dossier.</h2>
    </div>
    <div class="capability-grid">
      <article><span>01</span><h3>Encoder</h3><p>Vue visuelle et XML réel : le TEI n’est pas un export. Personnes, lieux, œuvres, dates, offices — dans le fichier que vous enregistrez.</p></article>
      <article><span>02</span><h3>Identifier</h3><p>Balisage automatique, désambiguïsation, packs d’autorités sur le disque (CBDB, DILA, CHGIS, Wikidata, NDL…).</p></article>
      <article><span>03</span><h3>Capitaliser</h3><p>Chaque décision entre dans <em>votre</em> base : fiches, dates, titres officiels. Réutilisable dans l’édition, la traduction, et Word.</p></article>
      <article><span>04</span><h3>Traduire</h3><p>Fichiers compagnons alignés sur la source. L’IA ne réécrit pas vos entités ; Zotero reste dans le volet de traduction.</p></article>
    </div>
  </section>

  <section class="home-screenshots" aria-label="Aperçus de l’interface">
    <div class="home-section-heading home-section-heading--light">
      <p class="eyebrow">L’atelier</p>
      <h2>Ce que l’on voit<br>en travaillant.</h2>
      <p>Captures provisoires — à remplacer par des vues réelles de l’éditeur, du panneau de désambiguïsation et de la base.</p>
    </div>
    <div class="screenshot-grid">
      <figure class="product-shot">
        <div class="product-shot__frame product-shot__frame--placeholder">
          <img src="{{ url('theme://images/screenshots/placeholder-editor.svg') }}" alt="Emplacement : éditeur visuel avec balises">
        </div>
        <figcaption><strong>Encoder</strong><span>Le texte et le TEI dans la même fenêtre.</span></figcaption>
      </figure>
      <figure class="product-shot">
        <div class="product-shot__frame product-shot__frame--placeholder">
          <img src="{{ url('theme://images/screenshots/placeholder-disambiguate.svg') }}" alt="Emplacement : panneau de désambiguïsation">
        </div>
        <figcaption><strong>Identifier</strong><span>Candidats d’autorité, décision conservée.</span></figcaption>
      </figure>
      <figure class="product-shot">
        <div class="product-shot__frame product-shot__frame--placeholder">
          <img src="{{ url('theme://images/screenshots/placeholder-database.svg') }}" alt="Emplacement : fenêtre de la base d’entités">
        </div>
        <figcaption><strong>Capitaliser</strong><span>La fiche, pas seulement la balise.</span></figcaption>
      </figure>
    </div>
  </section>

  <section class="home-workflow">
    <div class="home-section-heading">
      <p class="eyebrow">Le parcours</p>
      <h2>Un projet,<br>pas un fichier.</h2>
    </div>
    <div class="workflow-copy">
      <p>Vous ouvrez un dossier : schéma, textes, traductions, base d’entités. Les quatre outils ci-dessus s’enchaînent dans cette unité.</p>
      <div class="workflow-grid">
        <article><span>01</span><h3>Ouvrir</h3><p>Créer ou ouvrir le projet.</p></article>
        <article><span>02</span><h3>Transcrire</h3><p>Importer ou écrire la source.</p></article>
        <article><span>03</span><h3>Encoder</h3><p>Baliser selon le schéma.</p></article>
        <article><span>04</span><h3>Identifier</h3><p>Décider dans la base.</p></article>
        <article><span>05</span><h3>Traduire</h3><p>Compagnon aligné, ou article.</p></article>
        <article><span>06</span><h3>Valider</h3><p>Schéma, enregistrement, copies.</p></article>
      </div>
      <a class="text-link" href="/guide/fonctions-de-base">La première heure du guide <span aria-hidden="true">→</span></a>
    </div>
    <figure class="product-shot product-shot--wide">
      <div class="product-shot__frame product-shot__frame--placeholder">
        <img src="{{ url('theme://images/screenshots/placeholder-project.svg') }}" alt="Emplacement : explorateur de projet et document ouvert">
      </div>
      <figcaption><strong>Le dossier de travail</strong><span>Explorateur, texte, panneaux — à remplacer par une capture réelle.</span></figcaption>
    </figure>
  </section>

  <section class="home-corpora">
    <div class="home-section-heading home-section-heading--light">
      <p class="eyebrow">Des chemins selon vos sources</p>
      <h2>Pour quels<br><em>corpus&nbsp;?</em></h2>
    </div>
    <div class="corpus-grid">
      <article>
        <h3>Chine et canon bouddhique</h3>
        <p>CBDB, DILA, CHGIS, Norbert, Kanripo, CBETA, Daozang — packs et imports sur le disque.</p>
        <a class="text-link" href="/ressources">Licences et packs <span aria-hidden="true">→</span></a>
      </article>
      <article>
        <h3>Japon et est-asiatique</h3>
        <p>NDL, Wikidata, Sanmiao pour les dates ; même logique de projet local.</p>
        <a class="text-link" href="/guide/fichiers">Imports et fichiers <span aria-hidden="true">→</span></a>
      </article>
      <article>
        <h3>Autre TEI</h3>
        <p>Schéma, validation, traduction compagnon. Pas les autorités chinoises par magie : un éditeur XML de bureau.</p>
        <a class="text-link" href="/comparaison">Où Grognard s’arrête <span aria-hidden="true">→</span></a>
      </article>
    </div>
  </section>

  <section class="home-comparison">
    <div class="home-section-heading home-section-heading--light">
      <p class="eyebrow">Parmi d’autres outils</p>
      <h2>Pourquoi Grognard&nbsp;?</h2>
    </div>
    <div class="comparison-copy">
      <p>oXygen édite le XML. Les plateformes web taguent en ligne. Grognard tague avec des autorités savantes <em>sur votre disque</em>, et verse les décisions dans une base à vous.</p>
    </div>
    <div class="comparison-table" role="table" aria-label="Trois paradigmes">
      <div role="row" class="comparison-table__head"><span role="columnheader">Outil</span><span role="columnheader">Fait bien</span><span role="columnheader">Laisse de côté</span></div>
      <div role="row"><strong role="cell">oXygen</strong><span role="cell">XML, XSLT, validation</span><span role="cell">Autorités est-asiatiques, base d’entités</span></div>
      <div role="row"><strong role="cell">Plateformes web</strong><span role="cell">Taggage, corpus en ligne</span><span role="cell">Fichiers locaux, scripts à côté, souveraineté</span></div>
      <div role="row"><strong role="cell">Grognard</strong><span role="cell">TEI local, packs, base, traduction</span><span role="cell">HTR, site public, chaîne XSLT</span></div>
    </div>
    <a class="text-link comparison-more" href="/comparaison">L’argument développé <span aria-hidden="true">↗</span></a>
  </section>

  <section class="home-facts">
    <div class="home-section-heading">
      <p class="eyebrow">À savoir</p>
      <h2>Bureau, libre,<br>encore en bêta.</h2>
    </div>
    <div class="facts-grid">
      <article><strong>Application de bureau</strong><p>macOS, Windows, Linux. Pas de compte pour éditer. <a href="/download#configuration">Taille et configuration</a>.</p></article>
      <article><strong>AGPL-3</strong><p>Le code est libre. Vos textes restent dans le projet. <a href="/projet">Crédits et licences de code</a>.</p></article>
      <article><strong>À la carte</strong><p>IA, classement, LanguageTool, packs d’autorités : seulement si vous les acceptez.</p></article>
    </div>
  </section>

  <section class="home-coda">
    <p class="eyebrow">Installer</p>
    <h2>Sur votre machine.</h2>
    <p>Installeurs signés pour Mac, Windows et Linux.</p>
    <div class="home-actions">
      <a class="button button--gold" href="/download">Télécharger Grognard <span aria-hidden="true">→</span></a>
    </div>
  </section>
{% endblock %}
