{% extends 'default.html.twig' %}

{% block main %}
  <main class="hero">
    <div class="hero__texture" aria-hidden="true"></div>
    <img class="hero__splash" src="{{ url('theme://images/long_splash.png') }}" alt="">
    <section class="hero__copy">
      <div class="hero__rule"><span></span><i>✦</i><span></span></div>
      <div class="hero__content">{{ page.content|raw }}</div>
    </section>
  </main>

  <section class="home-paradigm">
    <div class="home-section-heading">
      <p class="eyebrow">Le produit</p>
      <h2>Un projet plutôt qu’un fichier isolé.</h2>
    </div>
    <div class="home-paradigm__copy">
      <p>Grognard est une application de bureau pour éditer des textes en XML-TEI. Un projet rassemble vos documents, votre schéma, vos traductions, votre base d’entités et l’historique de vos décisions.</p>
      <p>Le XML n’est pas un format d’export ajouté à la fin : c’est le document de travail. Vous pouvez commencer dans la vue visuelle, puis consulter ou modifier la structure source lorsque vous en avez besoin.</p>
      <a class="text-link" href="/guide/fonctions-de-base">Voir le guide des fonctions de base <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="home-capabilities">
    <div class="home-section-heading">
      <p class="eyebrow">Ce que Grognard fait</p>
      <h2>Des outils concrets<br>pour chaque étape.</h2>
    </div>
    <div class="capability-grid">
      <article><span>01</span><h3>Balisage XML-TEI</h3><p>Identifiez les personnes, lieux, œuvres, dates et organisations pendant la transcription, dans une structure ouverte et lisible.</p></article>
      <article><span>02</span><h3>Désambiguïsation</h3><p>Reliez les mentions aux autorités et construisez une base d’entités locale, consultable et réutilisable.</p></article>
      <article><span>03</span><h3>Traductions compagnons</h3><p>Conservez plusieurs traductions alignées sur le même texte source, sans dupliquer ni altérer l’original.</p></article>
      <article><span>04</span><h3>Travail hors ligne</h3><p>Vos fichiers, votre base et la plupart des ressources restent sur votre ordinateur. L’IA et les services en ligne sont facultatifs.</p></article>
    </div>
  </section>

  <section class="home-corpora">
    <div class="home-section-heading home-section-heading--light">
      <p class="eyebrow">Des chemins selon vos sources</p>
      <h2>Pour quels<br><em>corpus&nbsp;?</em></h2>
    </div>
    <div class="corpus-grid">
      <article><h3>Textes chinois et bouddhiques</h3><p>Les packs et plugins peuvent s’appuyer sur CBDB, DILA, CHGIS, CBETA, Kanripo et d’autres ressources spécialisées.</p><a class="text-link" href="/guide/fichiers">Voir les sources prises en charge <span aria-hidden="true">→</span></a></article>
      <article><h3>Textes japonais et est-asiatiques</h3><p>Les outils d’autorité et de dates accompagnent l’identification, la conversion et la traduction de textes historiques.</p><a class="text-link" href="/guide/base-de-donnees">Découvrir la base d’entités <span aria-hidden="true">→</span></a></article>
      <article><h3>Autres corpus XML-TEI</h3><p>Avec un schéma adapté, Grognard offre un environnement général pour éditer, valider et transmettre d’autres corpus structurés.</p><a class="text-link" href="/comparaison">Comparer avec d’autres outils <span aria-hidden="true">→</span></a></article>
    </div>
  </section>

  <section class="home-workflow">
    <div class="home-section-heading home-section-heading--light">
      <p class="eyebrow">Le parcours</p>
      <h2>Une seule chaîne<br>de travail.</h2>
    </div>
    <div class="workflow-grid">
      <article><span>01</span><h3>Ouvrir</h3><p>Créez un projet et importez une source dans son dossier de travail.</p></article>
      <article><span>02</span><h3>Transcrire</h3><p>Écrivez ou corrigez le texte source dans la vue visuelle.</p></article>
      <article><span>03</span><h3>Structurer</h3><p>Ajoutez les balises prévues par le schéma et marquez les changements éditoriaux.</p></article>
      <article><span>04</span><h3>Identifier</h3><p>Désambiguïsez les entités et rattachez-les à votre base locale.</p></article>
      <article><span>05</span><h3>Traduire</h3><p>Travaillez dans des fichiers compagnons alignés sur la source.</p></article>
      <article><span>06</span><h3>Valider</h3><p>Contrôlez le XML, recherchez dans le corpus et conservez son historique.</p></article>
    </div>
  </section>

  <section class="home-comparison">
    <div class="home-section-heading home-section-heading--light">
      <p class="eyebrow">Une autre manière de travailler</p>
      <h2>Pourquoi Grognard&nbsp;?</h2>
    </div>
    <div class="comparison-copy">
      <p>Les éditeurs XML généralistes donnent du contrôle mais peu de contexte savant. Les outils web facilitent le partage mais dépendent d’un serveur, d’un dépôt ou d’une connexion.</p>
      <p>Grognard choisit un autre centre de gravité : le document local du chercheur, ses fichiers ouverts, ses autorités, ses traductions et son histoire.</p>
    </div>
    <div class="comparison-table" role="table" aria-label="Comparaison des paradigmes d’édition">
      <div role="row" class="comparison-table__head"><span role="columnheader">Paradigme</span><span role="columnheader">Centre de gravité</span><span role="columnheader">Ce que Grognard privilégie</span></div>
      <div role="row"><strong role="cell">XML généraliste</strong><span role="cell">Le format et la conformité</span><span role="cell">Le format <em>et</em> le geste éditorial</span></div>
      <div role="row"><strong role="cell">Édition web</strong><span role="cell">Le serveur et la collaboration</span><span role="cell">Le local, l’autonomie et le partage choisi</span></div>
      <div role="row"><strong role="cell">Grognard</strong><span role="cell">Le document savant</span><span role="cell">Structure, précision, clarté</span></div>
    </div>
    <a class="text-link comparison-more" href="/comparaison">Comparer Grognard avec d’autres outils <span aria-hidden="true">↗</span></a>
  </section>

  <section class="home-facts">
    <div class="home-section-heading">
      <p class="eyebrow">À savoir</p>
      <h2>Un outil libre,<br>encore en bêta.</h2>
    </div>
    <div class="facts-grid">
      <article><strong>Application de bureau</strong><p>Grognard fonctionne sur macOS, Windows et Linux. L’édition normale ne nécessite ni compte ni connexion.</p></article>
      <article><strong>Logiciel libre</strong><p>Le code est distribué sous licence <a href="https://www.gnu.org/licenses/old-licenses/gpl-2.0.html">GPL-2</a>. Les données restent dans vos projets locaux.</p></article>
      <article><strong>Services à la carte</strong><p>Recherche d’autorité, classement, sauvegarde cloud et IA ne sont utilisés que si vous les choisissez.</p></article>
    </div>
  </section>
{% endblock %}
