{% extends 'default.html.twig' %}

{% block main %}
  <main class="comparison-page-main">
    <section class="comparison-hero" style="background-image: url('/images/tool_splash.png');">
      <div class="comparison-hero__copy">
        <p class="eyebrow">Grognard</p>
        <h1>{{ page.title }}</h1>
        <h2>{{ page.header.comparison_kicker }}</h2>
        <p>{{ page.header.comparison_intro }}</p>
      </div>
    </section>
    <section class="page-content page-content--standard comparison-content">
      <article>
        <div class="prose">{{ page.content|raw }}</div>
      </article>
    </section>
  </main>
{% endblock %}
