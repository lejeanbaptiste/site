{% extends 'default.html.twig' %}

{% block main %}
  <main class="project-page-main">
    <section class="project-hero">
      <div class="project-hero__copy">
        <p class="eyebrow">Grognard</p>
        <h1>{{ page.title }}</h1>
        <h2>{{ page.header.project_kicker }}</h2>
        <div class="project-hero__intro">{{ page.header.project_intro|markdown|raw }}</div>
      </div>
    </section>
    <section class="page-content page-content--standard project-content">
      <article>
        <div class="prose">{{ page.content|raw }}</div>
      </article>
    </section>
  </main>
{% endblock %}
